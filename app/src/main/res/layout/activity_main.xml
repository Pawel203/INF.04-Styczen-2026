<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#2E7CB8">



    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:src="@drawable/zad1"
            android:layout_width="350dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:id="@+id/obrazek"/>

        <TextView
            android:text="Które to schronisko?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="30dp"
            android:layout_gravity="center"
            android:id="@+id/pytanie"/>
        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <RadioButton
            android:text="Na Rysiance."
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_gravity="left"
            android:id="@+id/radio1"/>
        <RadioButton
            android:text="Na Wielkiej Raczy."
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_gravity="left"
            android:id="@+id/radio2"/>
        <RadioButton
            android:text="Na Wielkiej Rycerzowej."
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_gravity="left"
            android:id="@+id/radio3"/>
        </RadioGroup>
        <Button
            android:text="DALEJ"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:onClick="dalej"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>